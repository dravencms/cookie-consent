{
  "name": "dravencms/cookie-consent",
  "type": "dravencms-package",
  "description": "Cookie consent module for dravencms",
  "keywords": [
    "dravencms",
    "cookie-consent"
  ],
  "license": [
    "LGPL-3.0-only"
  ],
  "authors": [
    {
      "name": "Adam Schubert"
    }
  ],
  "require": {
    "dravencms/admin": "^3.0",
    "dravencms/locale": "^2.1",
    "nette/di": "^3.2.6",
    "dravencms/application": "^0.3",
    "dravencms/packager": "^3.0"
  },
  "suggest": {
    "dravencms/structure": "Allows cookie consent components to be used in cms"
  },
  "require-dev": {
    "nette/tester": "@dev"
  },
  "autoload": {
    "psr-0": {
      "Dravencms\\": "src/"
    }
  },
  "extra": {
    "dravencms": {
      "configuration": "dravencms.config.neon",
      "assets": {
        "public": "%wwwDir%/assets/cookieConsent"
      }
    }
  },
  "conflict": {
    "dravencms/user": "<3.1",
    "dravencms/admin": "<3.2"
  },
  "scripts": {
    "build:assets": "build-public-assets"
  }
}
