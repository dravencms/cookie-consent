<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <ul class="nav nav-tabs" role="tablist">
            <li n:foreach="$activeLocales as $activeLocale" role="presentation" class="nav-item"><a n:class="$activeLocale->isDefault() ? active, nav-link" href="#{$activeLocale->getLanguageCode()}" aria-controls="home"
                                                                                                                                 role="tab" data-bs-toggle="tab"><span
                            class="flag-icon flag-icon-{$activeLocale->getCountry()->getCode()|lower}"></span> {$activeLocale->getName()}</a></li>
        </ul>
        <div class="tab-content">
            <div n:foreach="$activeLocales as $activeLocale" role="tabpanel" n:class="$activeLocale->isDefault() ? active, tab-pane" id="{$activeLocale->getLanguageCode()}">
                {formContainer $activeLocale->getLanguageCode()}
                    <fieldset>
                        <legend>{$activeLocale->getName()}</legend>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="title">{_"cookieConsent.title"} <sup>*</sup></label>
                                    <input type="text" n:name="title" autofocus="autofocus" class="form-control">
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="description">{_"cookieConsent.description"} <sup>*</sup></label>
                                    <textarea n:name="description" class="form-control"></textarea>
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="revisionMessage">{_"cookieConsent.revisionMessage"} <sup>*</sup></label>
                                    <textarea n:name="revisionMessage" class="form-control"></textarea>
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="personalDataProtectionUrl">{_"cookieConsent.personalDataProtectionUrl"}</label>
                                    <input type="url" n:name="personalDataProtectionUrl"  class="form-control">
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="cookiesInformationUrl">{_"cookieConsent.cookiesInformationUrl"}</label>
                                    <input type="url" n:name="cookiesInformationUrl"  class="form-control">
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->

                    </fieldset>
                {/formContainer}
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="identifier">{_"cookieConsent.identifier"} <sup>*</sup></label>
                    <input type="text" n:name="identifier" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="mode">{_"cookieConsent.mode"} <sup>*</sup></label>
                    <select n:name="mode" class="form-control"></select>
                </div>
            </div><!-- col-sm-6 -->
            
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="cookieExpiration">{_"cookieConsent.cookieExpiration"}</label>
                    <input type="number" n:name="cookieExpiration" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="cookieDomain">{_"cookieConsent.cookieDomain"}</label>
                    <input type="text" n:name="cookieDomain" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isActive" class="form-check-input"> <span class="form-check-label">{_"cookieConsent.isActive"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isAutoclearCookies" class="form-check-input"> <span class="form-check-label">{_"cookieConsent.isAutoclearCookies"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isPageScripts" class="form-check-input"> <span class="form-check-label">{_"cookieConsent.isPageScripts"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isForceConsent" class="form-check-input"> <span class="form-check-label">{_"cookieConsent.isForceConsent"}</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_"cookieConsent.save"}">
    </div>
</form>
